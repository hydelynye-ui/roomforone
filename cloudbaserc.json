{
  "version": "2.1",
  "envId": "focus-space-d5gmg1bimc422765f",
  "hosting": [
    {
      "name": "roomforone",
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDir": "dist",
      "deployPath": "/roomforone"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/roomforone",
        "target": "hosting:roomforone"
      }
    ]
  }
}
